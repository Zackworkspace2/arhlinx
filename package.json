{
  "name": "arhlinx",
  "version": "0.1.0",
  "description": "ArhLinx - Complete Network Control",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --configLoader native",
    "dev:hosted": "vite --mode hosted --configLoader native",
    "build": "vite build --configLoader native",
    "build:hosted": "vite build --mode hosted --configLoader native",
    "verify:hosted": "vite build --mode hosted --configLoader native --outDir ../../dist-hosted --emptyOutDir && node scripts/smoke-hosted.mjs",
    "start": "node server/index.mjs",
    "preview": "vite preview --configLoader native",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node server/netsh.test.mjs && node server/speed.test.mjs && node server/usage.test.mjs && node server/firewall.test.mjs && node server/network.test.mjs && node server/monitor.test.mjs && node server/coverage.test.mjs && node server/settings.test.mjs && node server/security.test.mjs && node server/devices.test.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  }
}
